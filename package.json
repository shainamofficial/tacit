{
  "name": "tacit",
  "private": true,
  "version": "0.0.0",
  "description": "Compiled, human-validated organizational knowledge served over MCP",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "docker compose up -d --wait && turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "eval": "tsx evals/run.ts",
    "mcp": "tsx packages/mcp-server/src/main.ts",
    "scan-report": "tsx apps/admin/src/scan-report.ts",
    "admin": "tsx apps/admin/src/main.ts",
    "compile": "tsx apps/workers/src/compile.ts",
    "db:migrate": "tsx packages/schema/src/cli.ts migrate",
    "db:reset": "tsx packages/schema/src/cli.ts reset",
    "corpus:build": "tsx evals/corpus/generator/build.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tacit/eslint-plugin": "workspace:*",
    "@types/node": "^22.0.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
