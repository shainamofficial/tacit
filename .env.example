# Copy to .env (git-ignored).
# Host port for the docker Postgres (docker-compose.yml). Change if 5432 is taken locally.
TACIT_PG_PORT=5432
DATABASE_URL=postgres://tacit:tacit@localhost:5432/tacit

# Model access is used only by @tacit/gateway (F-CMP-3). Leave empty until Session 4.
ANTHROPIC_API_KEY=

# GitHub App (read-only: contents, metadata, pull requests). Used by the workers; connector tests run offline.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Live connector tests (optional). GITHUB_TOKEN can be `gh auth token`; the smoke repo is a private
# copy of the synthetic Northwind monorepo with one merged PR.
GITHUB_TOKEN=
GITHUB_SMOKE_REPO=shainamofficial/tacit-connector-smoke

# Slack bot token (read-only scopes listed in packages/connectors/slack/src/web.ts). Connector tests run offline.
SLACK_BOT_TOKEN=
# Google service account JSON (drive.readonly, domain-wide delegation) and the user to impersonate.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_SUBJECT=

# Admin connect flow (pnpm admin, F-ADM-1)
TACIT_ORG_ID=
TACIT_ADMIN_TOKEN=
TACIT_PUBLIC_URL=http://127.0.0.1:3400
# 32 bytes hex/base64; seals OAuth tokens into source_credentials (schema PR 0004). Unset = tokens kept in memory.
TACIT_MASTER_KEY=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_APP_SLUG=
# MCP server (pnpm mcp): JSON array of {token,email,org_id}
TACIT_MCP_TOKENS=
